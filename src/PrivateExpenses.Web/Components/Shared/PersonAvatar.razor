@using PrivateExpenses.Web.Support

@if (AvatarUrl is not null && Size != "xs")
{
    <img class="avatar avatar-@Size" style="object-fit:cover;" src="@AvatarUrl" alt="@Name" title="@Name" />
}
else
{
    <span class="avatar avatar-@Size" style="@PersonColorPalette.AvatarStyle(ColorKey)" title="@Name">
        @Initial
    </span>
}

@code {
    [Parameter, EditorRequired] public string Initial { get; set; } = "";
    [Parameter, EditorRequired] public string ColorKey { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Size { get; set; } = "md";

    /// <summary>URL of the person's uploaded profile photo, or null to fall back to the colored
    /// initial-letter avatar. Pass <c>PersonAvatarUrl.For(person)</c> for a full Person entity.
    /// Ignored at Size="xs" (22px) — a detailed photo just reads as a muddy blob at that size, the
    /// bold single letter is genuinely more legible there.</summary>
    [Parameter] public string? AvatarUrl { get; set; }
}
