@* The BonSplit mark: a circle split into three wedges, one per household member, each keeping its
   own color identity (Kevin blue / Wesley violet / Jos amber) — the same three colors used for
   avatars, chips and balances everywhere else in the app. *@
<span class="logo" style="@Style">
    <svg class="logo-mark" width="@Size" height="@Size" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 20 L20 2 A18 18 0 0 1 34.6 29.5 Z" fill="var(--person-blue)" />
        <path d="M20 20 L34.6 29.5 A18 18 0 0 1 5.4 29.5 Z" fill="var(--person-amber)" />
        <path d="M20 20 L5.4 29.5 A18 18 0 0 1 20 2 Z" fill="var(--person-violet)" />
        <circle cx="20" cy="20" r="18" fill="none" stroke="@BackgroundColor" stroke-width="2" />
    </svg>
    @if (ShowWordmark)
    {
        <span class="logo-word" style="font-size:@(WordmarkSize)px;color:@WordmarkColor;">BonSplit</span>
    }
</span>

@code {
    [Parameter] public int Size { get; set; } = 28;
    [Parameter] public int WordmarkSize { get; set; } = 18;
    [Parameter] public bool ShowWordmark { get; set; } = true;
    [Parameter] public string BackgroundColor { get; set; } = "white";
    [Parameter] public string WordmarkColor { get; set; } = "var(--color-text)";
    [Parameter] public string Style { get; set; } = "";
}
