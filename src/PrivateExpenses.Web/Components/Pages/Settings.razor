@page "/instellingen"

<PageTitle>Instellingen</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Instellingen</h1>
        <p class="page-subtitle">Algemene informatie over deze installatie</p>
    </div>
</div>

<div class="card card-padded" style="max-width:520px;">
    <div class="stack" style="gap:14px;">
        <div style="display:flex;justify-content:space-between;">
            <span class="text-muted text-sm">Munteenheid</span>
            <span class="text-sm" style="font-weight:600;">Euro (EUR)</span>
        </div>
        <div style="display:flex;justify-content:space-between;">
            <span class="text-muted text-sm">Datum- en getalnotatie</span>
            <span class="text-sm" style="font-weight:600;">Nederlands (nl-NL)</span>
        </div>
        <div style="display:flex;justify-content:space-between;">
            <span class="text-muted text-sm">Personen beheren</span>
            <a href="/personen" class="text-sm" style="font-weight:600;color:var(--color-primary);">Naar Personen →</a>
        </div>
    </div>
</div>
