@page "/meer"
@using PrivateExpenses.Web.Services
@inject CurrentPersonState CurrentPerson

<PageTitle>Meer</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Meer</h1>
    </div>
</div>

<div class="card">
    <div class="stack" style="gap:0;">
        <a href="/personen" class="list-row">
            <span class="list-row-icon"><Icon Name="users" Size="18" /></span>
            <span class="list-row-main"><span class="list-row-title">Personen</span></span>
            <Icon Name="chevron-right" Size="18" />
        </a>
        <a href="/extern" class="list-row">
            <span class="list-row-icon"><Icon Name="wallet" Size="18" /></span>
            <span class="list-row-main"><span class="list-row-title">Extern</span></span>
            <Icon Name="chevron-right" Size="18" />
        </a>
        <a href="/instellingen" class="list-row">
            <span class="list-row-icon"><Icon Name="settings" Size="18" /></span>
            <span class="list-row-main"><span class="list-row-title">Instellingen</span></span>
            <Icon Name="chevron-right" Size="18" />
        </a>
        <button type="button" class="list-row clickable" style="border:none;background:none;width:100%;text-align:left;font:inherit;color:inherit;cursor:pointer;" @onclick="() => CurrentPerson.RequestChange()">
            <span class="list-row-icon"><Icon Name="log-out" Size="18" /></span>
            <span class="list-row-main"><span class="list-row-title">Uitloggen</span></span>
        </button>
    </div>
</div>
