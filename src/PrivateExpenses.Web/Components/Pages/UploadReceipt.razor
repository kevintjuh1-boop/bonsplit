@page "/bon/nieuw"
@using PrivateExpenses.Application.Exceptions
@using PrivateExpenses.Application.Validation
@inject IReceiptImportService ReceiptImportService
@inject NavigationManager Navigation
@inject ILogger<UploadReceipt> Logger

<PageTitle>Bon uploaden</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Bon uploaden</h1>
        <p class="page-subtitle">Foto, kassabon of PDF — maximaal 20 MB</p>
    </div>
</div>

@if (_errorMessage is not null)
{
    <div class="banner banner-danger" style="margin-bottom:20px;max-width:640px;">
        <Icon Name="alert-triangle" Size="18" />
        <div>
            <span>@_errorMessage</span>
            <div style="margin-top:8px;display:flex;gap:8px;">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Reset">Opnieuw proberen</button>
                <a href="/uitgaven/handmatig" class="btn btn-secondary btn-sm">Handmatig invoeren</a>
            </div>
        </div>
    </div>
}

@if (_duplicateMatches.Count > 0 && !_duplicateAcknowledged)
{
    <div class="banner banner-warning" style="margin-bottom:20px;max-width:640px;flex-direction:column;align-items:stretch;">
        <div style="display:flex;gap:12px;">
            <Icon Name="alert-triangle" Size="18" />
            <span style="font-weight:700;">Deze bon lijkt al eerder toegevoegd.</span>
        </div>
        <div class="stack" style="gap:6px;margin:10px 0;">
            @foreach (var match in _duplicateMatches)
            {
                <a href="@($"/uitgaven/{match.ExpenseId}")" class="text-sm" style="color:var(--color-warning-text);text-decoration:underline;">
                    @match.MerchantName · @match.ExpenseDate.ToString("d MMMM yyyy", MoneyFormatter.DutchCulture) · @MoneyFormatter.Format(match.TotalCents)
                </a>
            }
        </div>
        <div style="display:flex;gap:8px;">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="Reset">Annuleren</button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="ContinueAfterDuplicateAsync">Toch toevoegen</button>
        </div>
    </div>
}
else if (_stage == Stage.PickFile)
{
    <div class="card" style="max-width:640px;position:relative;">
        @if (_uploadingFile)
        {
            <div class="upload-progress-overlay">
                <LoadingSpinner Size="36" />
                <p style="font-weight:700;margin:14px 0 2px;">Bon uploaden — @_uploadSeconds sec</p>
                <p class="text-muted text-sm" style="margin:0;text-align:center;max-width:280px;">
                    @if (_uploadSeconds < 10)
                    {
                        <text>Even geduld…</text>
                    }
                    else
                    {
                        <text>Dit kan op een mobiele verbinding een tijdje duren. Niet wegklikken.</text>
                    }
                </p>
            </div>
        }
        <div class="card-padded">
            <label class="dropzone" for="receipt-file-desktop">
                <Icon Name="upload" Size="28" />
                <span style="font-weight:700;">Sleep een bestand hierheen of klik om te bladeren</span>
                <span class="text-muted text-sm">JPG, PNG, WEBP of PDF</span>
                <InputFile @key="_inputKey" id="receipt-file-desktop" OnChange="OnFileSelected" accept=".jpg,.jpeg,.png,.webp,.pdf" class="dropzone-input" />
            </label>

            <div class="mobile-capture-actions">
                <label class="btn btn-primary btn-block" for="receipt-file-camera">
                    <Icon Name="camera" Size="18" /> Foto maken
                    <InputFile @key="_inputKey" id="receipt-file-camera" OnChange="OnFileSelected" accept="image/*" class="visually-hidden" />
                </label>
                <label class="btn btn-secondary btn-block" for="receipt-file-gallery">
                    <Icon Name="image" Size="18" /> Kies bestand
                    <InputFile @key="_inputKey" id="receipt-file-gallery" OnChange="OnFileSelected" accept=".jpg,.jpeg,.png,.webp,.pdf" class="visually-hidden" />
                </label>
            </div>

            <p class="text-muted text-sm" style="margin-top:14px;margin-bottom:0;">
                Gebeurt er niets nadat je een bestand hebt gekozen? Dat kan gebeuren als je telefoon de
                verbinding heel even onderbreekt terwijl de galerij of camera open staat. Probeer het
                gewoon nog een keer — dat lukt dan direct.
            </p>
        </div>
    </div>
}
else if (_stage != Stage.Error)
{
    <div class="card card-padded" style="max-width:480px;">
        <div class="stack" style="gap:14px;">
            @foreach (var step in ProgressSteps)
            {
                var done = step.Key < _stage;
                var current = step.Key == _stage;
                <div style="display:flex;align-items:center;gap:10px;">
                    <span class="avatar avatar-sm" style="@(done ? "background:var(--color-success-soft);color:var(--color-success-text);" : current ? "background:var(--color-primary-soft);color:var(--color-primary-text);" : "")">
                        @if (done)
                        {
                            <Icon Name="check" Size="14" />
                        }
                        else
                        {
                            <span>@((int)step.Key + 1)</span>
                        }
                    </span>
                    <span class="text-sm" style="font-weight:@(current || done ? "700" : "500");color:@(current || done ? "var(--color-text)" : "var(--color-text-subtle))");">
                        @step.Value
                        @if (current && step.Key == Stage.Analyzing)
                        {
                            <LoadingSpinner Size="14" Centered="false" />
                            <span class="text-muted"> — @_analyzingSeconds sec</span>
                        }
                    </span>
                </div>
            }
            @if (_stage == Stage.Analyzing)
            {
                <p class="text-muted text-sm" style="margin:0;">
                    Dit duurt meestal een paar seconden.
                    @if (_analyzingSeconds >= 15)
                    {
                        <text> Bij een lastig leesbare bon kan het iets langer duren.</text>
                    }
                </p>
            }
        </div>
    </div>
}

<style>
    .dropzone {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 48px 24px;
        border: 2px dashed var(--color-border-strong);
        border-radius: var(--radius-md);
        color: var(--color-text-muted);
        cursor: pointer;
        text-align: center;
    }

    .dropzone:hover {
        border-color: var(--color-primary);
        background: var(--color-primary-soft);
    }

    .dropzone-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .mobile-capture-actions {
        display: none;
    }

    .upload-progress-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: var(--color-surface);
        border-radius: var(--radius-lg);
    }

    @@media (max-width: 700px) {
        .dropzone { display: none; }
        .mobile-capture-actions { display: flex; flex-direction: column; gap: 10px; }
    }
</style>

@code {
    private enum Stage { PickFile, Uploading, PreparingDocument, Analyzing, RecognizingItems, ReviewingResult, Error }

    private static readonly Dictionary<Stage, string> ProgressSteps = new()
    {
        [Stage.Uploading] = "Upload ontvangen",
        [Stage.PreparingDocument] = "Document voorbereiden",
        [Stage.Analyzing] = "Bon analyseren",
        [Stage.RecognizingItems] = "Productregels herkennen",
        [Stage.ReviewingResult] = "Resultaat controleren",
    };

    private Stage _stage = Stage.PickFile;
    private string? _errorMessage;
    private List<DuplicateMatchDto> _duplicateMatches = [];
    private bool _duplicateAcknowledged;
    private Guid _documentId;
    private int _analyzingSeconds;
    private bool _uploadingFile;
    private int _uploadSeconds;

    // Bumped every time we return to the picker so the <InputFile> elements are torn down and
    // recreated (via @key) rather than reused. A reused element keeps the browser's previous
    // FileList, and selecting the exact same file again then does not raise a new "change" event at
    // all — silently leaving the picker looking untouched, with no request ever reaching the server.
    private int _inputKey;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _duplicateMatches = [];
        _duplicateAcknowledged = false;
        var file = e.File;

        // The browser→server file transfer runs over the SignalR circuit (RemoteBrowserFileStream),
        // several interop round-trips reading chunks. If the circuit hiccups mid-transfer (backgrounded
        // mobile tab, brief network blip) those calls can hang indefinitely with no exception at all —
        // there is nothing on the .NET side to time them out by default. A hard deadline here turns that
        // silent, permanent hang into a visible, recoverable error instead. 180s (not 60s) because a
        // self-hosted deployment reached directly over a mobile connection (no CDN/edge network smoothing
        // things out, unlike the earlier Render deployment) can genuinely need longer for a few MB.
        using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(180));

        // The file-select handler itself never remounts the InputFile (see the note below), so it's
        // safe to show a loading overlay for the transfer — unlike the later stage transitions, this
        // one doesn't risk killing the in-flight JS interop read.
        _uploadingFile = true;
        _uploadSeconds = 0;
        StateHasChanged();

        using var uploadTickerCts = new CancellationTokenSource();
        var uploadTickerTask = TickUploadSecondsAsync(uploadTickerCts.Token);

        try
        {
            try
            {
                Logger.LogInformation("Receipt upload starting: {FileName} ({FileSize} bytes)", file.Name, file.Size);

                // Read and upload the file BEFORE switching away from the PickFile stage. Blazor's InputFile
                // reads browser bytes via JS interop tied to the <InputFile> DOM element itself — if a
                // StateHasChanged() here unmounts that element (by switching the UI to the progress view)
                // while the transfer is still in flight, the interop call throws
                // "Cannot read properties of null (reading '_blazorFilesById')" because the element it needs
                // to read from is already gone. Only update _stage once the bytes are safely on the server.
                await using var stream = file.OpenReadStream(ReceiptFileValidator.MaxFileSizeBytes, timeoutCts.Token);
                var result = await ReceiptImportService.UploadAsync(stream, file.Name, file.ContentType, file.Size, timeoutCts.Token);
                _documentId = result.DocumentId;

                Logger.LogInformation("Receipt upload finished: {DocumentId}", _documentId);

                _stage = Stage.Uploading;

                if (result.DuplicateMatches.Count > 0)
                {
                    _duplicateMatches = result.DuplicateMatches.ToList();
                    _stage = Stage.PickFile;
                    _inputKey++;
                }
            }
            catch (ExpenseValidationException ex)
            {
                _errorMessage = ex.Message;
                _stage = Stage.Error;
            }
            catch (IOException)
            {
                _errorMessage = $"Dit bestand is te groot. Maximaal {ReceiptFileValidator.MaxFileSizeBytes / 1024 / 1024} MB.";
                _stage = Stage.Error;
            }
            catch (OperationCanceledException) when (timeoutCts.IsCancellationRequested)
            {
                Logger.LogWarning("Receipt upload timed out for {FileName}", file.Name);
                _errorMessage = "Uploaden duurde te lang. Controleer je verbinding en probeer het opnieuw.";
                _stage = Stage.Error;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Receipt upload failed unexpectedly for {FileName}", file.Name);
                _errorMessage = "Uploaden is onverwacht mislukt. Probeer het opnieuw.";
                _stage = Stage.Error;
            }
        }
        finally
        {
            _uploadingFile = false;
            uploadTickerCts.Cancel();
            await uploadTickerTask;
        }

        if (_stage == Stage.Uploading)
        {
            await ContinueToAnalysisAsync();
        }

        StateHasChanged();
    }

    private Task ContinueAfterDuplicateAsync()
    {
        _duplicateAcknowledged = true;
        return ContinueToAnalysisAsync();
    }

    private async Task ContinueToAnalysisAsync()
    {
        try
        {
            _stage = Stage.PreparingDocument;
            StateHasChanged();
            await Task.Delay(150);

            _stage = Stage.Analyzing;
            _analyzingSeconds = 0;
            StateHasChanged();

            using var tickerCts = new CancellationTokenSource();
            var tickerTask = TickAnalyzingSecondsAsync(tickerCts.Token);
            try
            {
                await ReceiptImportService.ParseAsync(_documentId);
            }
            finally
            {
                tickerCts.Cancel();
                await tickerTask;
            }

            _stage = Stage.RecognizingItems;
            StateHasChanged();
            await Task.Delay(150);

            _stage = Stage.ReviewingResult;
            StateHasChanged();
            await Task.Delay(150);

            Navigation.NavigateTo($"/bon/{_documentId}/beoordelen");
        }
        catch (ExpenseValidationException ex)
        {
            _errorMessage = ex.Message;
            _stage = Stage.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Receipt analysis failed unexpectedly for document {DocumentId}", _documentId);
            _errorMessage = "Verwerken van de bon is onverwacht mislukt. Probeer het opnieuw.";
            _stage = Stage.Error;
        }
    }

    private void Reset()
    {
        _stage = Stage.PickFile;
        _errorMessage = null;
        _duplicateMatches = [];
        _duplicateAcknowledged = false;
        _inputKey++;
    }

    private async Task TickAnalyzingSecondsAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1000, cancellationToken);
                _analyzingSeconds++;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected once ParseAsync completes and the caller cancels the ticker.
        }
    }

    private async Task TickUploadSecondsAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1000, cancellationToken);
                _uploadSeconds++;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected once the upload attempt finishes and the caller cancels the ticker.
        }
    }
}
