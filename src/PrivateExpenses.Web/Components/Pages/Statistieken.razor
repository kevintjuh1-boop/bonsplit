@page "/statistieken"
@inject IExpenseService ExpenseService

<PageTitle>Statistieken</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Statistieken</h1>
        <p class="page-subtitle">Uitgaven per maand, over tijd</p>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_allMonths.Count == 0)
{
    <div class="card">
        <EmptyState IconName="scale" Title="Nog geen gegevens" Description="Zodra er uitgaven zijn, verschijnt hier de trend per maand." />
    </div>
}
else
{
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        @foreach (var option in RangeOptions)
        {
            <button type="button" class="pill-filter @(_filter == option.Filter ? "active" : "")" @onclick="() => SetFilter(option.Filter)">
                @option.Label
            </button>
        }
    </div>

    <div class="grid grid-stats" style="margin-bottom:16px;">
        <div class="stat-tile">
            <span class="stat-tile-label">Totaal deze periode</span>
            <span class="stat-tile-value">@MoneyFormatter.Format(FilteredMonths.Sum(m => m.TotalCents))</span>
        </div>
        <div class="stat-tile">
            <span class="stat-tile-label">Gemiddeld per maand</span>
            <span class="stat-tile-value">@MoneyFormatter.Format(AverageMonthlyCents)</span>
        </div>
    </div>

    <div class="card card-padded" style="margin-bottom:20px;">
        <RadzenChart>
            <RadzenColumnSeries Data="@ChartPoints" CategoryProperty="MonthLabel" ValueProperty="Euros" Title="Uitgaven" Fill="#22d3a6">
                <TooltipTemplate Context="point">
                    <div>
                        <strong>@MoneyFormatter.Format((long)Math.Round(point.Euros * 100))</strong>
                        <div class="text-muted" style="text-transform:capitalize;">@point.FullLabel</div>
                    </div>
                </TooltipTemplate>
            </RadzenColumnSeries>
            <RadzenValueAxis Formatter="@FormatEuroAxisValue">
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
            <RadzenCategoryAxis Padding="8" />
        </RadzenChart>
    </div>

    <div class="card card-padded">
        <div class="card-header"><span class="card-title">Per maand</span></div>
        <div class="stack" style="gap:0;">
            @foreach (var month in Enumerable.Reverse(FilteredMonths))
            {
                <div class="list-row">
                    <span class="list-row-main list-row-title" style="text-transform:capitalize;">@month.MonthStart.ToString("MMMM yyyy", MoneyFormatter.DutchCulture)</span>
                    <span class="list-row-amount">@MoneyFormatter.Format(month.TotalCents)</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum RangeFilter { All, ThisYear, Last12Months, Last6Months }

    private sealed record ChartPoint(string MonthLabel, string FullLabel, decimal Euros);

    private static readonly (RangeFilter Filter, string Label)[] RangeOptions =
    [
        (RangeFilter.All, "Alles"),
        (RangeFilter.ThisYear, "Dit jaar"),
        (RangeFilter.Last12Months, "Laatste 12 maanden"),
        (RangeFilter.Last6Months, "Laatste 6 maanden"),
    ];

    private bool _loading = true;
    private List<MonthlyTotalDto> _allMonths = [];
    private RangeFilter _filter = RangeFilter.All;

    private List<MonthlyTotalDto> FilteredMonths => _filter switch
    {
        RangeFilter.ThisYear => _allMonths.Where(m => m.MonthStart.Year == DateTime.Today.Year).ToList(),
        RangeFilter.Last12Months => _allMonths.Where(m => m.MonthStart >= CurrentMonthStart.AddMonths(-11)).ToList(),
        RangeFilter.Last6Months => _allMonths.Where(m => m.MonthStart >= CurrentMonthStart.AddMonths(-5)).ToList(),
        _ => _allMonths,
    };

    private List<ChartPoint> ChartPoints => FilteredMonths
        .Select(m => new ChartPoint(
            m.MonthStart.ToString("MMM", MoneyFormatter.DutchCulture),
            m.MonthStart.ToString("MMMM yyyy", MoneyFormatter.DutchCulture),
            m.TotalCents / 100m))
        .ToList();

    private static DateOnly CurrentMonthStart => new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private long AverageMonthlyCents => FilteredMonths.Count == 0 ? 0 : FilteredMonths.Sum(m => m.TotalCents) / FilteredMonths.Count;

    protected override async Task OnInitializedAsync()
    {
        _allMonths = await ExpenseService.GetMonthlyTotalsAsync();
        _loading = false;
    }

    private void SetFilter(RangeFilter filter) => _filter = filter;

    private static string FormatEuroAxisValue(object value) => $"€{Convert.ToDecimal(value):N0}";
}
