@inherits LayoutComponentBase

<PersonPicker>
    <div class="app-shell">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <div class="app-main">
            <header class="app-topbar-mobile">
                <BonSplitLogo Size="26" WordmarkSize="16" />
                <NotificationBell />
            </header>

            <div class="app-topbar-desktop">
                <NotificationBell />
            </div>

            <main class="app-content">
                @Body
            </main>

            <BottomNav />
        </div>
    </div>
</PersonPicker>

<div id="blazor-error-ui" data-nosnippet>
    Er is een onverwachte fout opgetreden.
    <a href="." class="reload">Herladen</a>
    <span class="dismiss">🗙</span>
</div>
