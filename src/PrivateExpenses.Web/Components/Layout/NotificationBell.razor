@using PrivateExpenses.Application.Abstractions.Services
@using PrivateExpenses.Application.Dtos
@using PrivateExpenses.Web.Services
@implements IDisposable
@inject INotificationService NotificationService
@inject CurrentPersonState CurrentPerson
@inject NavigationManager Navigation

<div class="notification-bell">
    <button type="button" class="notification-bell-button" @onclick="ToggleOpenAsync" aria-label="Meldingen">
        <Icon Name="bell" Size="20" />
        @if (_unreadCount > 0)
        {
            <span class="notification-bell-badge">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    </button>

    @if (_open)
    {
        <div class="notification-panel card">
            <div class="notification-panel-header">Meldingen</div>
            @if (_loading)
            {
                <LoadingSpinner Size="24" />
            }
            else if (_notifications.Count == 0)
            {
                <p class="text-muted text-sm" style="padding:16px;">Nog geen meldingen.</p>
            }
            else
            {
                <div class="notification-panel-list">
                    @foreach (var notification in _notifications)
                    {
                        <div class="notification-item @(notification.IsRead ? "" : "notification-item-unread")" @onclick="() => GoToExpense(notification)">
                            <p class="text-sm">@notification.Message</p>
                            <span class="text-subtle" style="font-size:12px;">@FormatRelative(notification.CreatedAt)</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .notification-bell {
        position: relative;
    }

    .notification-bell-button {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full);
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text);
        cursor: pointer;
    }

    .notification-bell-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: var(--radius-full);
        background: var(--color-danger);
        color: white;
        font-size: 10.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .notification-panel {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 320px;
        max-width: calc(100vw - 32px);
        max-height: 380px;
        overflow-y: auto;
        z-index: 40;
    }

    .notification-panel-header {
        padding: 14px 16px;
        font-weight: 700;
        font-size: 14px;
        border-bottom: 1px solid var(--color-border);
    }

    .notification-panel-list {
        display: flex;
        flex-direction: column;
    }

    .notification-item {
        padding: 12px 16px;
        border-bottom: 1px solid var(--color-border);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .notification-item:last-child {
        border-bottom: none;
    }

    .notification-item:hover {
        background: var(--color-surface-muted);
    }

    .notification-item-unread {
        background: var(--color-mint-soft);
    }
</style>

@code {
    private List<NotificationDto> _notifications = [];
    private int _unreadCount;
    private bool _open;
    private bool _loading;
    private System.Threading.Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        CurrentPerson.Changed += OnCurrentPersonChanged;
        await RefreshUnreadCountAsync();
        _pollTimer = new System.Threading.Timer(
            async _ => await InvokeAsync(RefreshUnreadCountAsync), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private void OnCurrentPersonChanged() => _ = InvokeAsync(RefreshUnreadCountAsync);

    private async Task RefreshUnreadCountAsync()
    {
        _unreadCount = CurrentPerson.CurrentPersonId is { } personId
            ? await NotificationService.GetUnreadCountAsync(personId)
            : 0;
        StateHasChanged();
    }

    private async Task ToggleOpenAsync()
    {
        _open = !_open;
        if (_open && CurrentPerson.CurrentPersonId is { } personId)
        {
            _loading = true;
            StateHasChanged();
            _notifications = await NotificationService.GetForPersonAsync(personId, 15);
            _loading = false;

            if (_unreadCount > 0)
            {
                await NotificationService.MarkAllReadAsync(personId);
                _unreadCount = 0;
            }
        }
    }

    private void GoToExpense(NotificationDto notification)
    {
        _open = false;
        if (notification.ExpenseId is { } expenseId)
        {
            Navigation.NavigateTo($"/uitgaven/{expenseId}");
        }
    }

    private static string FormatRelative(DateTime createdAtUtc)
    {
        var span = DateTime.UtcNow - createdAtUtc;
        if (span.TotalMinutes < 1) return "zojuist";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min geleden";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} uur geleden";
        return $"{(int)span.TotalDays} dag(en) geleden";
    }

    public void Dispose()
    {
        CurrentPerson.Changed -= OnCurrentPersonChanged;
        _pollTimer?.Dispose();
    }
}
